import mysql.connector

# Connect to MySQL
conn = mysql.connector.connect
(
    host="localhost",
    user="root",          # your MySQL username
    password="yourpassword",  # your MySQL password
    database="bookstore_db"
)
cursor = conn.cursor()

wishlist = []

def search_book(title):
    cursor.execute("SELECT * FROM books WHERE title = %s", (title,))
    return cursor.fetchone()

def add_to_wishlist(book):
    wishlist.append(book)

def display_wishlist():
    if not wishlist:
        print("Your wishlist is empty.")
        return
    print("\nYour Wishlist:")
    total_cost = 0
    for book in wishlist:
        print(f"• {book[1]} by {book[2]} - ₹{book[3]:.2f}")
        total_cost += float(book[3])
    print(f"Total Cost: ₹{total_cost:.2f}\n")

# Main Loop
while True:
    print("\n--- Bookstore Wishlist System ---")
    print("1. Search and add book to wishlist")
    print("2. View wishlist")
    print("3. Exit")
    choice = input("Enter your choice: ")

    if choice == "1":
        title = input("Enter book title to search: ")
        book = search_book(title)
        if book:
            print(f"Book found: {book[1]} by {book[2]} - ₹{book[3]:.2f}")
            add = input("Add to wishlist? (y/n): ").lower()
            if add == "y":
                add_to_wishlist(book)
                print("Book added to wishlist.")
        else:
            print("Book not found.")
    elif choice == "2":
        display_wishlist()
    elif choice == "3":
        print("Exiting... Goodbye!")
        break
    else:
        print("Invalid choice. Please try again.")

cursor.close()
conn.close()
